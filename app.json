{
  "expo": {
    "name": "bmverse2",
    "slug": "bmverse2",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bmverse2",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "eu.bruu.bmverse2",
      "backgroundColor": "#000000",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "eu.bruu.bmverse2",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "BMverse2",
      "shortName": "BMverse2",
      "description": "BABYMETAL Fan App",
      "backgroundColor": "#000000",
      "themeColor": "#000000",
      "barStyle": "black-translucent",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://bmverse2.bruu.eu"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraLines": ["AsyncStorage_db_size_in_MB=10"]
          }
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "@react-native-vector-icons/octicons",
      "@react-native-vector-icons/feather",
      "@react-native-vector-icons/material-icons",
      "expo-document-picker",
      "expo-file-system",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://bmverse2.bruu.eu"
      },
      "eas": {
        "projectId": "777dff8d-b5cb-401c-8fe8-045f75656806"
      }
    },
    "owner": "merlinbaer"
  }
}
